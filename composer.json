{
    "name": "james-draper/archipelago",
    "description": "PHP 5.0.0+ compatible legacy refactoring framework.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "files": ["archipelago/bootstrap.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "require": {
        "php": ">=5.0.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan-phpunit": "^2.1",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan-mockery": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan",
            "@php-cs-fixer"
        ],
        "phpunit": [
            "@phpunit.type-formatter",
            "@phpunit.unit",
            "@phpunit.integration"
        ],
        "phpunit.coverage": "phpunit --coverage-html coverage",
        "phpunit.type-formatter": "phpunit --testsuite=type-formatter",
        "phpunit.unit": "phpunit --testsuite=unit",
        "phpunit.integration": "phpunit --testsuite=integration",
        "phpstan": [
            "@phpstan.src",
            "@phpstan.test"
        ],
        "phpstan.src": "phpstan analyze -c phpstan.neon.src.dist",
        "phpstan.test": "phpstan analyze -c phpstan.neon.test.dist",
        "php-cs-fixer": [
            "@php-cs-fixer.src",
            "@php-cs-fixer.test"
        ],
        "php-cs-fixer.src": "php-cs-fixer fix --config=.php-cs-fixer.src.dist.php -v --diff --dry-run",
        "php-cs-fixer.test": "php-cs-fixer fix --config=.php-cs-fixer.test.dist.php -v --diff --dry-run"
    }
}
